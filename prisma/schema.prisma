// datasource e generator continuam os mesmos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  //shadowDatabaseUrl = env("DATABASE_URL")
}

model Livro {
  idLivro   Int     @id @default(autoincrement())
  titulo    String
  ano       Int
  edicao    Int
  editora   String
  isbn      String

  // Relacionamento com Genero (Muitos Livros para Um Gênero)


  // Relacionamento com Estoque (Um Livro para Um Estoque)
  estoque   Estoque? // O '?' indica que um livro pode não ter um estoque (opcional)

  // Relacionamento com Autor (Muitos Livros para Muitos Autores)
  autores   Autor[] @relation("LivroAutor")

  Genero Genero[]
}

model Genero {
  idGenero      Int     @id @default(autoincrement())
  nomeDoGenero  String  @unique
  
  livros        Livro[] // Um Gênero pode ter vários livros
}

model Autor {
  idAutor       Int     @id @default(autoincrement())
  nome          String
  nacionalidade String?
  matricula     String?     // opcional, evita erro se não houver valor
  
  livros        Livro[] @relation("LivroAutor") // ← torne opcional se não quiser preencher agora
}

model Estoque {
  idEstoque          Int     @id @default(autoincrement())
  quantidade  Int
  
  // Relacionamento com Livro (Um Estoque para Um Livro)
  livro       Livro   @relation(fields: [idlivro], references: [idLivro])
  idlivro     Int     @unique // A chave estrangeira fica aqui e @unique garante a relação 1-para-1
}